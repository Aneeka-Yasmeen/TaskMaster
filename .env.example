# Copy this file to .env and put your real key in .env (which is git-ignored).
# Never put a real key in this file: .env.example is meant to be committed.
NEBIUS_API_KEY=your-nebius-token-factory-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional JSON merged into every request, e.g. {"chat_template_kwargs": {"enable_thinking": false}}
# NEBIUS_EXTRA_BODY=
